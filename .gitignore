# runs, data, weights and environments stay out of git (scripts fetch or regenerate them)
/outputs
/off/
/data/*
!/data/README.md
!/data/MANIFEST.json
!/data/cubicasa/
!/data/own_house/
/data/own_house/*
!/data/own_house/gt/
!/data/k65/
/data/k65/*
!/data/k65/gt/
/weights
/envs
/.venv
/third_party
/captures/
photo_work/
*.ply
*.npz
*.mp4
*.mov
*.MOV
*.heic
*.HEIC

# python
__pycache__/
*.pyc
.pytest_cache/

# simulator caches
.simcache/

# images and model files: runs write them under outputs/; figures for the docs go in docs/img/
*.png
*.jpg
*.jpeg
!docs/img/*
*.pkl
*.h5
*.pt
*.pth
*.safetensors
# the CubiCasa export (Play Store app) is small enough for git
!/data/cubicasa/*
